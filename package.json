{
  "name": "dsh-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo of DeepSeek Harness (dsh) plugins: a fake-ip aware web_fetch provider.",
  "license": "MIT",
  "engines": {
    "node": ">=20.16.0"
  },
  "workspaces": [
    "dsh-*"
  ],
  "scripts": {
    "check": "pnpm run check:syntax",
    "check:syntax": "node --check dsh-web-fetch-http-fakeip/index.js && node --check dsh-web-fetch-http-fakeip/test/smoke.mjs",
    "test": "pnpm run test:fakeip",
    "test:fakeip": "node dsh-web-fetch-http-fakeip/test/smoke.mjs",
    "pack:fakeip": "pnpm --dir dsh-web-fetch-http-fakeip pack"
  }
}
